---
const projects = [
  {
    title: 'Field Service Management (PWA)',
    description: 'A Field Service Management web application for a plastic injection machine sales and maintenance company, supporting both a web dashboard and a mobile PWA for field technicians.',
    tags: ['React', 'TypeScript', 'Vite', 'Tailwind CSS', 'Supabase'],
    image: 'from-blue-500/20 to-cyan-900/20',
    year: '2026',
    link: '#',
  },
  {
    title: 'Omnichannel Platform',
    description: 'A real-time omnichannel web application that centralizes messages from multiple platforms into a single system, enabling seamless communication without switching between apps.',
    tags: ['React', 'TypeScript', 'Node.js', 'Express', 'PostgreSQL', 'Redis', 'Socket.IO'],
    image: 'from-emerald-500/20 to-teal-900/20',
    year: '2026',
    link: '#',
  },
  {
    title: 'PPP Green Service',
    description: 'A dashboard-based data management web application for a palm oil business to collect and manage vehicle license plate image data captured from a mobile application.',
    tags: ['JavaScript', 'Node.js', 'Express.js', 'MySQL'],
    image: 'from-lime-500/20 to-green-900/20',
    year: '2026',
    link: '#',
  },
  {
    title: 'Telemedicine UI Design',
    description: 'Designed wireframes and high-fidelity prototypes for a telemedicine platform with a strong focus on UX principles and clean visual hierarchy.',
    tags: ['Figma', 'Adobe Illustrator', 'UX Design'],
    image: 'from-pink-500/20 to-rose-900/20',
    year: '2025',
    link: '#',
  },
  {
    title: 'LINE Official Account Chatbot',
    description: 'A clothing store chatbot solution built on LINE Official Account, integrated with Dialogflow and a Node.js webhook to automate customer interactions, with Firebase for real-time data storage.',
    tags: ['LINE OA', 'Dialogflow', 'Node.js', 'Firebase'],
    image: 'from-amber-500/20 to-orange-900/20',
    year: '2023',
    link: '#',
  },
  {
    title: 'E-Commerce Platform',
    description: 'A full-stack e-commerce platform for computer accessories with a PHP and MySQL backend, featuring a responsive frontend built with HTML, CSS, JavaScript, and Tailwind CSS.',
    tags: ['PHP', 'MySQL', 'JavaScript', 'Tailwind CSS'],
    image: 'from-violet-500/20 to-purple-900/20',
    year: '2023',
    link: '#',
  },
